## Global_config
setup_global_envs.enable_H1F1B = True
setup_global_envs.enable_ZRP = True    
setup_global_envs.enable_Hetero = True

setup_global_envs.layer_construction_eps = 0.5
setup_global_envs.NCCL_MAX_CTAS_CROSS_RESHARDING = 4
setup_global_envs.profile_memory_safe_level = [0, 0]
# homo sub-cluster 内的 inter-node之间的带宽（若只有一台机器，随便填写）
setup_global_envs.intra_cluster_network_performance = [ 
    {"bandwidth": 25, "latency": 1e-5},   # V100
    {"bandwidth": 25, "latency": 1e-5},   # A100
]
# 不同的 sub-cluster 之间的 inter-node之间的带宽（若只有一台机器，随便填写）
setup_global_envs.inter_cluster_network_performance = [
    {"bandwidth": 0.625, "latency": 0.001},   # V100 <-> A100
    None,   # A101 <-> V100
]
setup_global_envs.enable_intra_ib = [True, True]
setup_global_envs.enable_inter_ib = [False, None]
setup_global_envs.enable_nsys = True

get_auto_stage_option.submesh_physical_shape_space = "single_node_power_of_two"
get_auto_stage_option.submesh_logical_shape_space = "single_node_model_parallel_and_safememory_dp"

# Jax use gemm to cacl embeding, make zrp work not well on very small gpt + large embedding model
# We should set small stage_imbalance_tolerance when train large model, but larger stage_imbalance_tolerance when small model
# get_auto_stage_option.stage_imbalance_tolerance = 0.3
# get_auto_stage_option.stage_imbalance_tolerance = 3


get_auto_stage_option.layer_profile_mode = "individual"


get_auto_stage_option.use_hlo_cost_model = True
get_auto_stage_option.profiling_database_filename = [
    "/workspace/benchmark/harp/prof_database_V100.pkl",
    "/workspace/benchmark/harp/prof_database_A100.pkl",
]
get_auto_stage_option.gpu_flops = [125, 312]
get_auto_stage_option.cluster_key = ["V100", "A100"]

# -- grid_search first
get_auto_stage_option.cached_compute_communication_cost_load_path = None
get_auto_stage_option.cached_compute_communication_cost_store_path_prefix = "/workspace/_tmp/2.6B-1x8V100_2x2A100/"

