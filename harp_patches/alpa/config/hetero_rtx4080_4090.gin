## Global_config
setup_global_envs.enable_geo_distribued = True
setup_global_envs.enable_zero_redundant_profiler = True    
setup_global_envs.enable_heterogeneous = True

setup_global_envs.layer_construction_eps = 0.5
setup_global_envs.NCCL_MAX_CTAS_CROSS_RESHARDING = -1
setup_global_envs.pipeline_use_signal_send_recv = False
setup_global_envs.profile_memory_safe_level = [0, 0]
setup_global_envs.DeivceMesh_Network_Performance = {
    "cluster_0":{
        "bandwidth": 12.5,
        "latency": 1e-5
    },
    "cluster_1": {
        "bandwidth": 12.5,
        "latency": 1e-5
    },
    "inter_link": {
        "bandwidth": 0.625,
        "latency": 0.001
    }}
setup_global_envs.enable_intra_ib = [0, 0]
setup_global_envs.enable_inter_ib = False
setup_global_envs.enable_stage_cache = False
setup_global_envs.enable_profile_cache = False
setup_global_envs.enable_nsys = True


get_auto_stage_option.submesh_physical_shape_space = "single_node_power_of_two"
get_auto_stage_option.submesh_logical_shape_space = "single_node_model_parallel_and_safememory_dp"

# Jax use gemm to cacl embeding, make zrp work not well on very small gpt + large embedding model
# We should set small stage_imbalance_tolerance when train large model, but larger stage_imbalance_tolerance when small model
# get_auto_stage_option.stage_imbalance_tolerance = 0.3
get_auto_stage_option.stage_imbalance_tolerance = 3


get_auto_stage_option.use_hlo_cost_model = True
get_auto_stage_option.profiling_database_filename = [
    "/workspace/benchmark/alpa/prof_database_enablePreAlloc_4080.pkl",
    "/workspace/benchmark/alpa/prof_database_enablePreAlloc_4090.pkl"
]
get_auto_stage_option.gpu_flops = [180, 113]
get_auto_stage_option.cluster_key = ["RTX4080", "RTX4090"]


